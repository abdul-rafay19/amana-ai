# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets.
# Add at least one key. Gemini is the main model, Groq gives voice (Whisper) and a fast backup.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
NVIDIA_API_KEY = ""
# Optional: PROVIDER_ORDER = "gemini,groq,nvidia"
# Optional model overrides (names change often, check each provider's docs):
# GEMINI_MODEL = "gemini-flash-lite-latest"
# GROQ_MODEL = "openai/gpt-oss-120b"
# NVIDIA_MODEL = "meta/llama-3.3-70b-instruct"
