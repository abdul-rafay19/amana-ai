# Copy to .env (same folder as llm.py) for local use, or paste into Streamlit Cloud > Settings > Secrets.
# Format: KEY=value with no quotes and no spaces around '='. Never commit the real .env.
# Add at least one key. Gemini is the main model, Groq gives voice (Whisper) and a fast backup.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# PROVIDER_ORDER=gemini,groq,nvidia
# Optional model overrides (names change often, check each provider's docs):
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
